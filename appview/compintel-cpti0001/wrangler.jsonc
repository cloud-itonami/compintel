{
  "name": "kotodama-cpti0001",
  // No "main": svelte/.svelte-kit/cloudflare/_worker.js is gone (svelte/ was
  // removed by the cljs migration, appview/compintel-cpti0001/cljs/). The
  // sibling src/app.ts was never wired to `main` even before this migration
  // (it does not call env.ASSETS.fetch — README.md "src/app.ts はデプロイ
  // されない") so repointing `main` at it here would put a worker in front of
  // the assets with nothing serving them. Dropping `main` makes this an
  // assets-only deployment: Cloudflare serves ./cljs/public directly.
  "compatibility_date": "2025-03-17",
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"trackCompetitor\",\"getSnapshot\",\"listCompetitors\",\"getAlert\"]",
    "APP_DESCRIPTION": "Competitive Intelligence Dashboard — LangGraph multi-dimension research loop. Weekly refresh Monday 08:00 JST. Threat scoring + alert digest via Resend.",
    "APP_DISPLAY_NAME": "etzhayyim Competitive Intel",
    "APP_EMBED_URL": "https://cpti0001.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "cpti0001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "cpti0001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "compintel.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
